{
  "name": "xurripoints",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "description": "Xurripoints — la moneda de la pareja: puntos, vales, tareas y gastos compartidos. App Android vía Capacitor + Firebase.",
  "scripts": {
    "build": "esbuild src/firebase.js --bundle --format=esm --minify --target=es2020 --outfile=app/vendor/firebase.js",
    "sync": "npm run build && cap sync android",
    "open": "cap open android",
    "serve": "npx http-server app -p 5173 -c-1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@firebase/rules-unit-testing": "^5.0.2",
    "esbuild": "^0.28.2"
  }
}
